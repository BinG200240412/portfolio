[Unit]
Description=BinG private CPU speech recognition
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=portfolio-speech
Group=portfolio-speech
WorkingDirectory=/opt/portfolio-speech
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=SPEECH_MODEL_DIR=/opt/portfolio-speech/model
ExecStart=/opt/portfolio-speech/venv/bin/python /opt/portfolio-speech/speech_worker.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=700M
CPUQuota=100%
TasksMax=32
LimitNOFILE=128

[Install]
WantedBy=multi-user.target
