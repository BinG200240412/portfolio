# Copy only to the server's private /etc/portfolio-ai/portfolio-ai.env.
# Never place a real key in this repository or a static hosting directory.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
SESSION_SECRET=
PORT=8788
QUOTA_DATABASE=/var/lib/portfolio-ai/quota.sqlite3
KNOWLEDGE_FILE=/opt/portfolio-ai/knowledge.md
ALLOWED_ORIGINS=https://bing2002.com
# Enable only behind the dedicated loopback Caddy proxy which overwrites X-Real-IP.
TRUST_LOOPBACK_PROXY=1
IP_MINUTE_LIMIT=6
IP_DAY_LIMIT=30
SESSION_DAY_LIMIT=20
GLOBAL_DAY_LIMIT=100
GLOBAL_MONTH_LIMIT=1000
