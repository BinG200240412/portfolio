# Copy only to the server's private /etc/portfolio-ai/portfolio-ai.env.
# Never place a real key in this repository or a static hosting directory.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
SESSION_SECRET=
PORT=8791
QUOTA_DATABASE=/var/lib/portfolio-ai/quota.sqlite3
KNOWLEDGE_FILE=/opt/portfolio-ai/knowledge.md
ALLOWED_ORIGINS=https://bing2002.com
# Enable only behind the dedicated loopback Caddy proxy which overwrites X-Real-IP.
TRUST_LOOPBACK_PROXY=1
IP_MINUTE_LIMIT=6
IP_DAY_LIMIT=30
SESSION_DAY_LIMIT=20
GLOBAL_DAY_LIMIT=100
GLOBAL_MONTH_LIMIT=1000
# Enable only after the selected provider passes real audio and account checks.
SPEECH_ENABLED=0
# local = private SenseVoice worker; doubao = Seed-ASR 2.0 one-sentence WS.
SPEECH_PROVIDER=local
# New Doubao Speech-console API Key, not an Ark LLM key or DeepSeek key.
# Keep the real value only in the server's private environment file.
DOUBAO_SPEECH_API_KEY=
VOICE_IP_MINUTE_LIMIT=3
VOICE_IP_DAY_LIMIT=20
VOICE_SESSION_DAY_LIMIT=15
VOICE_GLOBAL_DAY_LIMIT=60
VOICE_GLOBAL_MONTH_LIMIT=600
